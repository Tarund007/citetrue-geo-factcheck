# Streamlit Secrets Template for CiteTrue GEO Fact-Checker
# Copy this file to .streamlit/secrets.toml and insert your API keys

# Gemini API Key (Required for claim extraction and verification reasoning)
# Get a key from: https://aistudio.google.com
GEMINI_API_KEY = "your-gemini-api-key-here"

# Tavily API Key (Required for live real-time web search and ground-truth retrieval)
# Get a free key with 1000 searches/mo from: https://tavily.com
TAVILY_API_KEY = "your-tavily-api-key-here"

# Optional Fallbacks
OPENAI_API_KEY = ""
SERPER_API_KEY = ""
